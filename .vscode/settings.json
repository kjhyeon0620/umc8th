{
    "java.templates.fileHeader": [
        "package ${package};",
        "",
        "/**",
        " * ${description}",
        " * @author ${user}",
        " * @since ${date}",
        " */"
    ],
    "java.templates.typeDeclarationBody": [
        "public class ${name} {",
        "    ${cursor}",
        "}"
    ],
    "editor.formatOnSave": true,
    "java.format.settings.url": ".vscode/java-formatter.xml",
    "java.format.settings.profile": "GoogleStyle"
} 